    "prompt-injection",
    "vllm-semantic-router",
    "vllm-sr",
    "system-duo",
    "system-one"
  ],
  "author": "Xunzhuo Liu",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Xunzhuo/dsh-system-one-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xunzhuo/dsh-system-one-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/Xunzhuo/dsh-system-one-plugin/issues"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
