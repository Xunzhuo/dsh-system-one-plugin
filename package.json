  "description": "System Duo for DeepSeek Harness. Make your agent think fast and slow: System One decision models triage, guard, shield, mask and check your agent loop beside System Two (vllm-sr/auto), with a free app.vllm-sr.ai key.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "agent",
    "decision-model",
    "guardrails",
    "prompt-injection",
    "vllm-semantic-router",
    "vllm-sr",
    "system-duo",
    "system-one"
  ],
  "author": "Xunzhuo Liu",
  "license": "Apache-2.0",
  "homepage": "https://github.com/Xunzhuo/dsh-system-one-plugin#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Xunzhuo/dsh-system-one-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/Xunzhuo/dsh-system-one-plugin/issues"
  },
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./web/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "web",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
